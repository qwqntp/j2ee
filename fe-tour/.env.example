# Copy this file to fe-tour/.env.local and fill in local values. Never commit .env.local.
# NEXT_PUBLIC_* values are inlined at build time, so set them before `npm run build`.

# Server-side API base URL (preferred for server renders).
API_URL=http://localhost:8080

# Browser-visible API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional: Google Identity Services client ID. Must match the backend GOOGLE_CLIENT_ID.
# Leave blank to hide the Google sign-in button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
