# Copy this file to tour/.env and fill in local values. Never commit .env.
# The file uses Java properties syntax (KEY=value), not shell export syntax.
# Placeholders only: replace every "change-me" before use.

# --- Database (defaults match a local PostgreSQL with database "tour") ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tour
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# --- Auth / CORS ---
# Required: at least 32 bytes, or the application fails at startup.
JWT_SECRET=change-me-to-a-random-32-byte-secret
APP_COOKIE_SECURE=false
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Flyway ---
SPRING_FLYWAY_ENABLED=true

# --- Redis read cache (optional; set SPRING_CACHE_TYPE=none to disable) ---
SPRING_CACHE_TYPE=redis
SPRING_CACHE_TTL=PT10M
SPRING_DATA_REDIS_URL=redis://localhost:6379
SPRING_DATA_REDIS_TIMEOUT=1s
SPRING_DATA_REDIS_CONNECT_TIMEOUT=1s

# --- Google sign-in (optional; blank hides the button and returns 503) ---
GOOGLE_CLIENT_ID=

# --- Email / SMTP (optional; blank host disables sending safely) ---
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true
SPRING_MAIL_SMTP_CONNECTIONTIMEOUT=5000
SPRING_MAIL_SMTP_TIMEOUT=5000
SPRING_MAIL_SMTP_WRITETIMEOUT=5000
MAIL_FROM=no-reply@tour.local
APP_FRONTEND_URL=http://localhost:3000
APP_TRUST_PROXY=false

# Legacy mail aliases (the SPRING_MAIL_* names above take precedence):
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true

# --- Payments ---
# Leave blank to fail signed callbacks closed. Demo card payments are off by default.
PAYMENT_CALLBACK_SECRET=
PAYMENT_MOCK_ENABLED=false

# --- VNPay Sandbox (optional; blank settings fail closed) ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return
VNPAY_IPN_TOKEN=
